{
  "openapi": "3.1.0",
  "info": {
    "title": "Finance Pattern Engine Market Data API",
    "version": "1.1.0",
    "description": "Static, read-only public crypto market data feed. Source data subject to provider terms and availability. Protected API Worker endpoints require a separately deployed Cloudflare Worker; replace YOUR-WORKER with its assigned hostname."
  },
  "servers": [
    {
      "url": "https://italocoin-project.github.io"
    }
  ],
  "paths": {
    "/api/v1/coins.json": {
      "get": {
        "summary": "Get latest cryptocurrency market snapshot",
        "operationId": "getLatestCoins",
        "responses": {
          "200": {
            "description": "Market snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketSnapshot"
                }
              }
            }
          },
          "503": {
            "description": "Static hosting or data source unavailable"
          }
        }
      }
    },
    "/data/market/{date}.jsonl": {
      "get": {
        "summary": "Get daily Coinbase spot price archive",
        "operationId": "getDailyArchive",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "description": "UTC date in YYYY-MM-DD format",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Newline-delimited JSON snapshots",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Archive not found"
          }
        }
      }
    },
    "/v1/coins": {
      "get": {
        "summary": "Get authenticated market snapshot from the Cloudflare API Worker",
        "description": "Requires a deployed Worker and a valid API key. Daily quotas depend on the assigned plan.",
        "servers": [
          {
            "url": "https://YOUR-WORKER.workers.dev"
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Market snapshot and quota metadata"
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "429": {
            "description": "Daily request quota exceeded"
          },
          "502": {
            "description": "Market data source unavailable"
          }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "summary": "Get usage history for the authenticated API key",
        "servers": [
          {
            "url": "https://YOUR-WORKER.workers.dev"
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Daily request counts for the last 30 days"
          },
          "401": {
            "description": "Missing or invalid API key"
          }
        }
      }
    },
    "/v1/watchlist": {
      "get": {
        "summary": "Download a private watchlist",
        "description": "Requires the private sync code in x-watchlist-key. Anyone holding this bearer secret can read and replace the associated watchlist.",
        "servers": [
          {
            "url": "https://YOUR-WORKER.workers.dev"
          }
        ],
        "security": [
          {
            "WatchlistKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Saved ticker symbols and update timestamp"
          },
          "401": {
            "description": "Missing or invalid watchlist key"
          }
        }
      },
      "put": {
        "summary": "Replace a private watchlist",
        "description": "Stores up to 100 ticker symbols. The client-generated secret is stored only as a SHA-256 hash.",
        "servers": [
          {
            "url": "https://YOUR-WORKER.workers.dev"
          }
        ],
        "security": [
          {
            "WatchlistKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "symbols"
                ],
                "properties": {
                  "symbols": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "maxLength": 15
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Watchlist saved"
          },
          "400": {
            "description": "Invalid ticker list"
          },
          "401": {
            "description": "Missing or invalid watchlist key"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MarketSnapshot": {
        "type": "object",
        "required": [
          "updated_at",
          "source",
          "count",
          "coins"
        ],
        "properties": {
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "bitcoin_dominance": {
            "type": [
              "number",
              "null"
            ]
          },
          "coins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Coin"
            }
          }
        }
      },
      "Coin": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "cmc_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "rank": {
            "type": "integer"
          },
          "price": {
            "type": [
              "number",
              "null"
            ]
          },
          "change_24h": {
            "type": [
              "number",
              "null"
            ]
          },
          "change_7d": {
            "type": [
              "number",
              "null"
            ]
          },
          "change_30d": {
            "type": [
              "number",
              "null"
            ]
          },
          "market_cap": {
            "type": [
              "number",
              "null"
            ]
          },
          "volume_24h": {
            "type": [
              "number",
              "null"
            ]
          },
          "circulating_supply": {
            "type": [
              "number",
              "null"
            ]
          },
          "total_supply": {
            "type": [
              "number",
              "null"
            ]
          },
          "max_supply": {
            "type": [
              "number",
              "null"
            ]
          },
          "last_updated": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      },
      "WatchlistKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-watchlist-key"
      }
    }
  }
}
